<credstick:CredstickTransferDialogWindow
    xmlns="https://spacestation14.io"
    xmlns:credstick="clr-namespace:Content.Client._FarHorizons.Banking.Credstick"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'credstick-transfer-window-title'}"
    MinSize="220 120">

    <BoxContainer Orientation="Vertical"
                  Margin="8"
                  SeparationOverride="8"
                  HorizontalExpand="True"
                  VerticalExpand="True">

        <!-- Input Section: Text LineEdit and Slider -->
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="6"
                      HorizontalExpand="True">

            <LineEdit Name="TransferAmountInput"
                      Text="0"
                      HorizontalExpand="False"
                      MinWidth="60"
                      MaxWidth="60"
                      Editable="False" />

            <Slider Name="TransferAmountSlider"
                    HorizontalExpand="True"
                    Margin="4 0 0 0" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 2" />

        <!-- Actions: Confirm / Cancel Buttons -->
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="6">
                      
            <Button Name="TransferConfirmButton"
                    Text="{Loc 'credstick-transfer-confirm'}"
                    HorizontalExpand="True" />
                    
            <Button Name="TransferCancelButton"
                    Text="{Loc 'credstick-transfer-cancel'}"
                    HorizontalExpand="True" />
        </BoxContainer>

    </BoxContainer>

</credstick:CredstickTransferDialogWindow>