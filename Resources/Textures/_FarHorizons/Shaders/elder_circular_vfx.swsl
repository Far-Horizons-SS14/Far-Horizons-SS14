light_mode unshaded;

uniform highp vec2 center;
uniform highp float range;
uniform bool outerCircle;
uniform highp float falloff_width;

uniform highp vec3 color1;
uniform highp vec3 color2;
uniform highp float noise_scale;
uniform highp float time_scale;
uniform highp float hole_threshold;

uniform highp vec2 viewportMin;
uniform highp vec2 viewportMax;

// Don't ever talk to me about math. I overcame, I'm healing, let me have my peace

highp vec2 hash(highp vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}

highp float noise(highp vec2 p) {
    const highp float K1 = 0.366025403; // (sqrt(3)-1)/2;
    const highp float K2 = 0.211324865; // (3-sqrt(3))/6;

    highp vec2 i = floor(p + (p.x + p.y) * K1);
    highp vec2 a = p - i + (i.x + i.y) * K2;
    highp float m = step(a.y, a.x);
    highp vec2 o = vec2(m, 1.0 - m);
    highp vec2 b = a - o + K2;
    highp vec2 c = a - 1.0 + 2.0 * K2;

    highp vec3 h = max(0.5 - vec3(dot(a, a), dot(b, b), dot(c, c)), 0.0);
    highp vec3 n = h * h * h * h * vec3(dot(a, hash(i + 0.0)), dot(b, hash(i + o)), dot(c, hash(i + 1.0)));

    return dot(n, vec3(70.0));
}

highp float fbm(highp vec2 p) {
    highp float value = 0.0;
    highp float amplitude = 0.5;
    highp float frequency = 1.0;
    for (highp int i = 0; i < 3; i++) {
        value += amplitude * noise(p * frequency);
        frequency *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

void fragment() {
    highp vec2 worldCoord = mix(viewportMin, viewportMax, UV);
    highp float dist = distance(worldCoord, center);

    highp vec2 noise_uv = worldCoord * noise_scale;
    highp float t = TIME * time_scale;

    highp vec2 q = vec2(
        fbm(noise_uv + vec2(0.0, 0.0) + vec2(t * 0.2, t * 0.1)),
        fbm(noise_uv + vec2(5.2, 1.3) + vec2(t * -0.15, t * 0.2))
    );

    highp vec2 r = vec2(
        fbm(noise_uv + 4.0 * q + vec2(1.7, 9.2) + t * 0.35),
        fbm(noise_uv + 4.0 * q + vec2(8.3, 2.8) + t * 0.15)
    );

    highp float f = fbm(noise_uv + 4.0 * r);
    highp float procedural_pattern = clamp((f + 1.0) * 0.5, 0.0, 1.0);

    highp vec3 mixed_color = mix(color1, color2, procedural_pattern);
    highp float hole_mask = smoothstep(hole_threshold, hole_threshold + 0.15, procedural_pattern);

    highp float alpha = 1.0;

    if (outerCircle) {
        if (dist < range) {
            discard;
        }

        alpha = clamp((dist - range) / falloff_width, 0.0, 1.0);
    } else {
        if (dist > range) {
            discard;
        }

        alpha = 1.0 - (dist / range);
    }

    highp float final_alpha = alpha * hole_mask;

    if (final_alpha < 0.001) {
        discard;
    }

    COLOR = vec4(mixed_color, final_alpha);
}